<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./partials/head') %>
    <link rel="stylesheet" href="/stylesheets/index.css">
</head>
<body>
    <%- include('./partials/header') %>
    <%- include('./partials/nav') %>

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <h1 class="hero-title">Lo que buscas, al mejor precio</h1>
                <p class="hero-subtitle">Explora nuestra colección de productos exclusivos, diseñados para brindarte la mejor calidad y estilo en tu día a día.</p>
                <a href="#catalogo" class="btn-hero">Ver Catálogo</a>
            </div>
        </section>

        <h2 id="catalogo">Nuestros Productos</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/">Productos</a></li>
        </ol>

        <form class="add-product" action="/products/new-product" method="get">
            <button id="submit" type="submit">Crear Producto Nuevo</button>
        </form>

        <%- include('./partials/cards') %>

    </main>

    <%- include('./partials/footer') %>
</body>

</html>