<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/stylesheets/product-detail.css">
</head>
<body>
    <%- include('../partials/header') %>

    <%- include('../partials/nav') %>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/">Productos</a></li>
        <li class="breadcrumb-item"><a href="/products/search?q=<%= category %>"><%= category %></a></li>
        <li class="breadcrumb-item"><a href="/products/search?q=<%= subcategory %>"><%= subcategory %></a></li>
    </ol>

    <main>
        <form class="edit-product" action="/products/edit/<%= id %>" method="get"> 
            <button id="submit" type="submit">Editar Producto</button> 
        </form>

        <div class="product-detail">
            <div class="product-img">
                <img src="/images/products/<%= image %>" alt="<%= name %>">
            </div>
            
            <h3 class="product-name"><%= name %></h3>
            <p class="product-brand"><b>Marca:</b> <%= brand %></p>
            <div class="product-quantity">
                <button class="down">-</button>
                <input type="number" name="quantity" class="quantity" value="1" min="1" >
                <button class="up">+</button>
            </div>

            <div class="product-price">
                <p id="price">$ <%= price %></p>
                <p>Contado o transferencia. Precio sin impuestos $ <%= price_cash %></p>
                <p><%= price_installment_count %> cuotas de $ <%= price_installment %></p>
            </div>
            
            <button class="add-cart" id="add-to-cart-btn" data-id="<%= id %>" data-name="<%= name %>" data-price="<%= price %>" data-img="/images/products/<%= image %>">Agregar al Carrito</button>
        </div>

        <div class="product-spec">
            <h3>Descripción</h3>
            <%- description %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>