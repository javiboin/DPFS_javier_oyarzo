<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/stylesheets/index.css">
</head>
<body>
    <%- include('../partials/header') %>

    <%- include('../partials/nav') %>

    <main>
        <h2>Resultados para: <%= searchTerm %></h2>

        <% if (products && products.length > 0) { %>
        <div class="container">

        <% products.forEach(product => { %>
            <div class="card">
                <a href="/products/product-detail/<%= product.productId %>"><img src="/images/<%= product.image %>" class="card-img-top" alt="<%= product.name %>"></a>
                <div class="card-body">
                    <h5 style="margin-bottom: 10px;"><%= product.name %></h5>
                    <p class="price"><b>$ <%= product.price %></b></p>
                    <p style="color: grey; font-size: 14px;">$ <%= product.priceCash %> con Transferencia o depósito</p>
                    <p style="color: red; font-size: 12px;"><%= product.priceInstallmentCount %> Coutas de $ <%= product.priceInstallment %></p>
                    <button><a href="/products/product-cart">Comprar</a></button>
                </div>
            </div>
        <% }); %>

        </div>

        <% } else { %>
            <p>No se encontraron productos que coincidan con tu búsqueda.</p>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>